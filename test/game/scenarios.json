        },
        {
          "cmd": "/fill {x-4} 301 {z-4} {x+4} 304 {z+4} air"
        },
        {
          "cmd": "/tp {andy} {x} 301 {z}"
        },
        {
          "tp": "{x} 301 {z-4}"
        },
        {
          "cmd": "/give {andy} wooden_hoe"
        },
        {
          "cmd": "/give {andy} wheat_seeds 16"
