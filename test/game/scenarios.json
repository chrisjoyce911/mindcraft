    {
      "name": "farm-water",
      "tags": [
        "full",
        "farm",
        "slow"
      ],
      "timeout": 600000,
      "grace": 20000,
      "requires": [
        "farm",
        "command"
      ],
      "description": "A 9x9 grass patch around andy with a row of 7 ripe wheat on wet farmland 2 blocks south and a water source beside it; andy has a hoe and 16 seeds. Chat \"andy farm wheat 5\": he harvests 5 wheat and stops.",
      "setup": [
        {
          "site": "farm"
        },
        {
          "tp": {
            "dz": -6
          }
        },
        {
          "cmd": "/clear {andy}"
        },
        {
          "cmd": "/fill {x-4} {y-2} {z-4} {x+4} {y-2} {z+4} dirt"
        },
        {
          "cmd": "/fill {x-4} {y-1} {z-4} {x+4} {y-1} {z+4} grass_block"
        },
        {
          "cmd": "/fill {x-4} {y} {z-4} {x+4} {y+3} {z+4} air"
        },
        {
          "cmd": "/fill {x-3} {y-1} {z+2} {x+3} {y-1} {z+2} farmland[moisture=7]"
        },
        {
          "cmd": "/fill {x-3} {y} {z+2} {x+3} {y} {z+2} wheat[age=7]"
        },
        {
          "cmd": "/setblock {x} {y-1} {z+3} water"
        },
        {
          "cmd": "/give {andy} wooden_hoe"
        },
        {
          "cmd": "/give {andy} wheat_seeds 16"
        }
      ],
      "action": [
        {
          "say": "andy farm wheat 5"
        }
      ],
      "checks": [
        {
          "type": "inventory",
          "item": "wheat",
          "min": 5
        },
        {
          "type": "reply",
          "match": "Harvested ([5-9]|\\d{2,}) wheat",
          "note": "the farm job's own count line, not any mention of harvesting"
        },
        {
          "type": "log",
          "task": "farm",
          "match": {
            "action": "harvest",
            "outcome": "done"
          }
        },
        {
          "type": "idle"
        }
      ],
      "cleanup": [
        {
          "andy": "!stop",
          "optional": true
        }
      ]
    },
    {
      "name": "farm-no-water",
      "tags": [
        "full",
        "farm"
      ],
      "timeout": 300000,
      "requires": [
