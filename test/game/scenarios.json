    {
      "name": "defend",
      "tags": [
        "quick",
        "full",
        "defend"
      ],
      "timeout": 150000,
      "description": "Andy follows tester; a husk (a zombie that doesn't burn in the locked daytime) is summoned 5 blocks east of him. He must kill it and go back to following (the interrupted job resumes). Sets difficulty easy.",
      "setup": [
        {
          "site": "base"
        },
        {
          "tp": {
            "dx": 2
          }
        },
        {
          "cmd": "/difficulty easy"
        },
        {
          "cmd": "/give {andy} iron_sword"
        }
      ],
      "action": [
        {
          "andy": "!followPlayer(\"{tester}\", 3)"
        },
        {
          "waitFor": {
            "action": "followPlayer"
          },
          "timeout": 15000
        },
        {
          "snapshot": "following"
        },
        {
          "anchor": true
        },
        {
          "cmd": "/summon husk {x+5} {y} {z}"
        },
        {
          "waitFor": {
            "entity": "husk"
          },
          "timeout": 10000,
          "optional": true
        },
        {
          "waitFor": {
            "entity": "husk",
            "present": false
          },
          "timeout": 90000
        },
        {
          "wait": 6000
        },
        {
          "cmd": "/execute positioned {x} {y} {z} if entity @e[type=husk,distance=..48]",
          "replyMs": 800
        }
      ],
      "wait": false,
      "checks": [
        {
          "type": "serverReply",
          "match": "Summoned"
        },
        {
          "type": "noEntity",
          "entity": "husk"
        },
        {
          "type": "serverReply",
          "match": "Test failed",
          "note": "no husk within 48 blocks: it died, not just wandered out of andy's sight"
        },
        {
          "type": "actionSeen",
          "match": "self_defense|laya_defending|defend|attack",
