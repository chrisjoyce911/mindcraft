      "name": "home-chest-chat",
      "tags": [
        "quick",
        "full",
        "home"
      ],
      "timeout": 30000,
      "grace": 2000,
      "requires": [
        "command"
      ],
      "description": "A chest 3 blocks west of andy, tester beside it; chat \"andy this is your chest\" (command model: home → !setHomeChest).",
      "setup": [
        {
          "site": "base"
