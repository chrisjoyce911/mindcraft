{
  "defaults": {
    "timeout": 120000,
    "grace": 6000,
    "settle": 3000,
    "idleFail": 30000
  },
  "tests": [
    {
      "name": "setup-world",
      "tags": [
        "quick",
        "full",
        "setup"
      ],
      "timeout": 30000,
      "description": "Puts tester beside andy in creative and locks the world to clear daytime. Also proves tester can run commands (cheats on).",
      "setup": [
        {
          "site": "base"
        }
      ],
      "action": [
        {
          "tp": {
            "dx": 2
          }
        },
        {
          "cmd": "/gamemode creative {tester}"
        },
        {
          "cmd": "/time set day"
        },
        {
          "cmd": "/gamerule doDaylightCycle false"
        },
        {
          "cmd": "/weather clear"
        },
        {
          "cmd": "/gamerule doWeatherCycle false"
        }
      ],
      "wait": false,
      "checks": [
        {
          "type": "serverReply",
          "match": "Set the time"
        },
        {
          "type": "serverReply",
          "match": "doDaylightCycle.*false|now set to"
        }
      ]
    },
    {
      "name": "follow",
      "tags": [
        "quick",
        "full",
        "follow"
      ],
      "timeout": 90000,
      "requires": [],
      "description": "Chat \"andy follow me\", tester walks 12 blocks east; andy must start following and end within 5 blocks of tester, having moved 6+ blocks.",
      "setup": [
        {
          "site": "base"
        },
        {
          "tp": {
            "dx": 2
          }
        }
      ],
      "action": [
        {
          "say": "andy follow me"
        },
        {
          "waitFor": {
            "action": "followPlayer"
          },
          "timeout": 30000
        },
        {
          "walk": {
            "dx": 12
          }
        },
        {
          "wait": 8000
        }
      ],
      "wait": false,
      "checks": [
        {
          "type": "actionSeen",
          "match": "followPlayer"
        },
        {
          "type": "near",
          "max": 5
        },
        {
          "type": "position",
          "axis": "dist",
          "min": 6
        }
      ],
      "cleanup": [
        {
          "andy": "!stop"
        }
      ]
    },
